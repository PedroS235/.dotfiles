# Host *
#     IdentityAgent ~/.1password/agent.sock
#     ForwardAgent yes

# DevPod Start esmros.devpod
Host esmros.devpod
  ForwardAgent yes
  LogLevel error
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/usr/local/bin/devpod" ssh --stdio --context default --user devuser esmros
  User devuser
# DevPod End esmros.devpod
# DevPod Start esmmetapackage.devpod
Host esmmetapackage.devpod
  ForwardAgent yes
  LogLevel error
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/usr/local/bin/devpod" ssh --stdio --context default --user devuser esmmetapackage
  User devuser
# DevPod End esmmetapackage.devpod
Host *
  SetEnv TERM=xterm-256color

